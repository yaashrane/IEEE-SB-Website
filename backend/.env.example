NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ieee-sb

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500
CLIENT_URL=http://localhost:3000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
MAX_UPLOAD_SIZE=5242880

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=your-app-password
EMAIL_FROM=IEEE Student Branch <notifications@example.com>
CONTACT_NOTIFY_EMAIL=ieee@example.edu

ADMIN_NAME=IEEE SB Admin
ADMIN_EMAIL=admin@ieee-sb.org
ADMIN_PASSWORD=Admin@123456
ADMIN_ROLE=super-admin
